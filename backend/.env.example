DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=bitacora_db
DB_USER=bitacora_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5187,http://localhost:5187,http://127.0.0.1:5012,http://localhost:5012

# Direct Send (puerto 25, sin auth) se probo el 12-08-2026 y NO funciona
# desde esta red (se cuelga esperando el saludo SMTP). Usar SMTP AUTH via
# una casilla de servicio de M365 (ver README, seccion "Correo / recordatorios").
EMAIL_ENABLED=False
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=bitacora@agrosuper.com
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=bitacora@agrosuper.com
# Si se define, redirige TODOS los correos de prueba a esta casilla en vez de a los responsables reales.
EMAIL_DEV_REDIRECT_TO=

# URL publica de la app, usada para armar el link "Ver en bITacora" dentro
# de los correos. En la PC servidor real: http://<ip-o-hostname>:5012
SITE_URL=http://localhost:5012

DIAS_ALERTA_AMARILLO=3
